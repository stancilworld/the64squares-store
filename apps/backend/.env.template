# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection
DATABASE_URL=postgres://postgres@localhost:5432/stancil
# Redis (sessions, events, jobs)
REDIS_URL=redis://localhost:6379

# Who may call the API: storefront, admin, auth (comma-separated)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# Change both to long random strings in production: openssl rand -hex 32
JWT_SECRET=change-me
COOKIE_SECRET=change-me
AUTH_MFA_ENCRYPTION_KEY=change-me-64-hex-characters

MEDUSA_ADMIN_ONBOARDING_TYPE=default
# Production only (set by deploy/setup-vps.sh)
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
