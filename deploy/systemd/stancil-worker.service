[Unit]
Description=Stancil background jobs (Medusa worker)
After=network.target postgresql.service redis-server.service


[Service]
Type=simple
User=stancil
WorkingDirectory=/opt/stancil/app/apps/backend/.medusa/server
EnvironmentFile=/opt/stancil/app/apps/backend/.medusa/server/.env
Environment=NODE_ENV=production
Environment=MEDUSA_WORKER_MODE=worker
Environment=DISABLE_MEDUSA_ADMIN=true
Environment=PORT=9001
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
MemoryMax=900M

[Install]
WantedBy=multi-user.target
